# AIL environment template
#
# Copy to `.env` and fill in the values you need:
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# `.env` is gitignored and must never be committed.
# Every variable below is optional EXCEPT where noted; the code falls back to
# the defaults shown in the comments. See core/config.py and
# integrations/open_interpreter/config.py for the authoritative defaults.

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
AIL_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# LLM provider
#
# NOTE: not yet wired to a provider. Config reads these values but no code
# consumes them yet; MockLLM is the only LLM implementation. Declared here so
# the intended shape is documented.
# ---------------------------------------------------------------------------
AIL_LLM_PROVIDER=openrouter
AIL_LLM_MODEL=your_model_id_here
AIL_LLM_API_KEY=your_api_key_here
AIL_LLM_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Open Interpreter App Server (the executor)
# ---------------------------------------------------------------------------
# Full path to the `interpreter` executable. Set this if it is not on PATH.
AIL_OI_EXECUTABLE=interpreter
AIL_OI_LISTEN=stdio://
AIL_OI_MODEL=
AIL_OI_MODEL_PROVIDER=
AIL_OI_APPROVAL_POLICY=never
AIL_OI_SANDBOX=read-only
AIL_OI_CWD=.
AIL_OI_REQUEST_TIMEOUT=120
AIL_OI_CONNECT_TIMEOUT=30
AIL_OI_LOG_LEVEL=INFO
# Comma-separated extra CLI args, e.g. --foo,--bar
AIL_OI_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# Speech-to-text (voice mode, faster-whisper)
# ---------------------------------------------------------------------------
AIL_STT_MODEL=tiny
AIL_STT_DEVICE=cpu
AIL_STT_COMPUTE_TYPE=int8

# ---------------------------------------------------------------------------
# Microphone capture (voice mode, sounddevice)
# ---------------------------------------------------------------------------
AIL_VOICE_SAMPLE_RATE=16000
AIL_VOICE_RECORD_SECONDS=5

# ---------------------------------------------------------------------------
# Text-to-speech (voice mode, edge-tts)
# ---------------------------------------------------------------------------
AIL_TTS_VOICE=en-US-AriaNeural
AIL_TTS_RATE=+0%
AIL_TTS_VOLUME=+0%
